# Supabase Configuration
# Your Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
# Your Supabase Anon Key (Safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Your Supabase Service Role Key (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Application URL
# The URL where your application is hosted (e.g. https://your-domain.com)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email Configuration (Resend)
# Your Resend API Key for sending emails
RESEND_API_KEY="re_your_resend_api_key"
# The email address you want to send emails from
EMAIL_FROM="info@your-domain.com"

# Security
# Secret for securing cron jobs/background tasks
CRON_SECRET="your-cron-secret-key"
# Secret for verifying incoming webhooks
WEBHOOK_SECRET="your-webhook-secret-key"

# Analytics
# Google Analytics ID (GA4)
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
